[Unit]
Description=FjordBudget Server - shared merchant knowledge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fjordbudget-server
Group=fjordbudget-server
WorkingDirectory=/opt/fjordbudget-server
EnvironmentFile=/etc/fjordbudget-server.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/fjordbudget-server/.venv/bin/gunicorn --bind 127.0.0.1:8088 --workers 1 --threads 8 --timeout 60 --access-logfile /dev/null fjordbudget_server.app:create_app()
Restart=on-failure
RestartSec=5
StateDirectory=fjordbudget-server
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fjordbudget-server
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
